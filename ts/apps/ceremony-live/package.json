{
  "name": "@libid/ceremony-live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An application that runs the CCDP ceremony for a platform identity in the browser, live.",
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "dev": "pnpm build:deps && node stack.ts --app",
    "dev:stack": "pnpm build:deps && node stack.ts",
    "build:deps": "pnpm --filter '@libid/ceremony-live^...' build",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@libid/ceremony": "workspace:^",
    "@libid/ledger": "workspace:^",
    "@libid/popup": "workspace:^",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "otpauth": "^9.4.0"
  }
}
